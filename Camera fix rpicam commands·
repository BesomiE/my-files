## COMPLETE DIAGNOSTIC SCRIPT (UPDATED)

```bash
cat > ~/camera_diagnostic_new.sh << 'EOF'
#!/bin/bash

echo "========================================"
echo "RASPBERRY PI CAMERA DIAGNOSTIC (NEW OS)"
echo "========================================"
echo ""

echo "OS Version:"
cat /etc/os-release | grep PRETTY_NAME
echo ""

echo "1. Checking camera interface..."
vcgencmd get_camera
echo ""

echo "2. Listing available cameras (rpicam)..."
if command -v rpicam-hello &> /dev/null; then
    rpicam-hello --list-cameras 2>&1 | head -n 20
else
    echo "rpicam-hello not found - checking for libcamera-hello..."
    if command -v libcamera-hello &> /dev/null; then
        libcamera-hello --list-cameras 2>&1 | head -n 20
    else
        echo "Neither rpicam-hello nor libcamera-hello found!"
        echo "Install with: sudo apt install rpicam-apps"
    fi
fi
echo ""

echo "3. Checking video devices..."
ls -l /dev/video* 2>/dev/null || echo "No video devices found"
echo ""

echo "4. Checking for camera processes..."
ps aux | grep -E "(rpicam|libcamera|picamera)" | grep -v grep || echo "No camera processes running"
echo ""

echo "5. Testing with Python (Picamera2)..."
python3 << 'PYTHON'
try:
    from picamera2 import Picamera2
    cameras = Picamera2.global_camera_info()
    print(f"Cameras detected: {len(cameras)}")
    if len(cameras) > 0:
        for i, cam in enumerate(cameras):
            print(f"  Camera {i}: {cam}")
        print("✓ Python can see camera(s)")
    else:
        print("✗ Python sees NO cameras")
except Exception as e:
    print(f"✗ Python error: {e}")
PYTHON
echo ""

echo "========================================"
echo "DIAGNOSTIC COMPLETE"
echo "========================================"
echo ""
echo "If camera detected=0, check cable connection!"
echo "If camera detected=1 but Python sees 0, restart:"
echo "  sudo reboot"
EOF

chmod +x ~/camera_diagnostic_new.sh
~/camera_diagnostic_new.sh
```

